{
  "manifestVersion": 5,
  "id": "com.reelcutter.ppro",
  "name": "Reel Cutter",
  "version": "1.0.1",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.3.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "reelCutterPanel",
      "label": {
        "default": "Reel Cutter"
      },
      "minimumSize": {
        "width": 300,
        "height": 300
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 650
      },
      "preferredFloatingSize": {
        "width": 480,
        "height": 750
      }
    }
  ],
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/icon.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "all"
      ],
      "species": [
        "generic"
      ]
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "https://raw.githubusercontent.com"
      ]
    },
    "localFileSystem": "plugin",
    "clipboard": "readAndWrite",
    "launchProcess": {
      "schemes": [
        "https"
      ]
    }
  }
}